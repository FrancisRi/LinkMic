    <item name="colorPrimaryContainer">@color/md_primary_container</item><item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
    <item name="colorSecondary">@color/md_secondary</item><item name="colorSurface">@color/md_surface</item><item name="colorOnSurface">@color/md_on_surface</item>
