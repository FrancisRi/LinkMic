<Window x:Class="LinkMic.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkMic">
  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>
  <NavigationView x:Name="WindowRoot" PaneDisplayMode="Left" OpenPaneLength="216"
                  IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                  SelectionChanged="NavigationChanged">
    <NavigationView.PaneHeader>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,12,0,20">
        <Image Source="ms-appx:///assets/LinkMic.png" Width="36" Height="36"/>
        <StackPanel>
          <TextBlock Text="LinkMic" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="手机麦克风" Style="{StaticResource Label}" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
    </NavigationView.PaneHeader>
    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="ConnectNav" Content="连接与音频">
        <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;"/></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="GuideNav" Content="使用指南">
        <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;"/></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="LogsNav" Content="运行日志">
        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <NavigationView.FooterMenuItems>
      <NavigationViewItem x:Name="SettingsNav" Content="设置" Icon="Setting"/>
    </NavigationView.FooterMenuItems>
    <NavigationView.PaneFooter>
      <TextBlock Text="LinkMic 0.3.5" Style="{StaticResource Label}" FontSize="12" Margin="16,14,0,12"/>
    </NavigationView.PaneFooter>
    <NavigationView.Content>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="28,20,28,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="PageTitle" Text="连接与音频" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="通过蓝牙或 Wi-Fi，让手机成为电脑的麦克风。" Style="{StaticResource Label}" Margin="0,8,16,0"/></StackPanel>
          <Border x:Name="StateContainer" Grid.Column="1" CornerRadius="4" Padding="10,6" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock x:Name="StateBadge" Text="●  未连接" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
          <Border x:Name="ConnectedBadge" Grid.Column="1" CornerRadius="4" Padding="10,6" VerticalAlignment="Top" Visibility="Collapsed" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"><TextBlock Text="●  已连接" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/></Border>
        </Grid>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,0">
          <Grid Margin="0,0,0,16">
            <StackPanel x:Name="ConnectPage">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="224"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="连接方式" Style="{StaticResource SectionTitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,12"><RadioButton x:Name="BluetoothMode" Content="蓝牙" GroupName="Mode" IsChecked="True" Checked="ModeChanged" Margin="0,0,28,0"/><RadioButton x:Name="WifiMode" Content="Wi-Fi" GroupName="Mode" Checked="ModeChanged"/></StackPanel>
                  <StackPanel x:Name="BluetoothPanel">
                    <TextBlock Text="已配对的手机" Style="{StaticResource Label}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ComboBox x:Name="Devices" HorizontalAlignment="Stretch" DisplayMemberPath="Display" MinHeight="34" SelectionChanged="DeviceSelected" AutomationProperties.Name="已配对的手机"/>
                      <Button Grid.Column="1" Content="刷新" Click="RefreshBluetooth" Margin="8,0,0,0" MinHeight="34" ToolTipService.ToolTip="刷新 Windows 已配对的蓝牙设备"/>
                    </Grid>
                    <Expander x:Name="AdvancedBluetooth" Header="手动输入蓝牙地址" Margin="0,10,0,0" FontSize="12"><TextBox x:Name="BluetoothAddress" Margin="0,8,0,0" ToolTipService.ToolTip="例如 AA:BB:CC:DD:EE:FF" AutomationProperties.Name="手机蓝牙地址"/></Expander>
                  </StackPanel>
                  <StackPanel x:Name="WifiPanel" Visibility="Collapsed"><TextBlock Text="本机局域网地址" Style="{StaticResource Label}"/><TextBox x:Name="LocalAddresses" IsReadOnly="True" FontSize="13" AutomationProperties.Name="电脑局域网地址"/><TextBlock Text="在手机输入此地址，接收端口为 42791。" Style="{StaticResource Label}" FontSize="12" Margin="0,10,0,0"/></StackPanel>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="首次配对" Style="{StaticResource SectionTitle}"/><TextBlock Text="新手机首次连接时输入此码" Style="{StaticResource Label}" FontSize="12" Margin="0,8,0,12"/>
                  <TextBox x:Name="PairCode" FontSize="28" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" IsReadOnly="True" TextAlignment="Center" Padding="8,10" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" AutomationProperties.Name="六位配对码"/>
                  <Button x:Name="RegenerateCodeButton" Content="更换配对码" Click="RegenerateCode" Margin="0,12,0,0" HorizontalAlignment="Stretch"/><TextBlock Text="已配对设备下次免输码" Style="{StaticResource Label}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel></Border>
              </Grid>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="麦克风输出" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择接收手机声音的音频设备" Style="{StaticResource Label}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                  <Button Grid.Column="1" Content="驱动文件" Click="OpenDriverFiles" ToolTipService.ToolTip="打开 VB-CABLE 原版驱动包和安装说明"/>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="Outputs" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OutputSelected" MinHeight="34" AutomationProperties.Name="音频输出设备"/><Button x:Name="OutputsRefreshButton" Grid.Column="1" Content="刷新" Click="RefreshOutputs" Margin="8,0,0,0" MinHeight="34" ToolTipService.ToolTip="刷新音频输出设备"/>
                </Grid>
                <TextBlock x:Name="OutputHint" Text="会议或录音软件请选择 CABLE Output。" Style="{StaticResource Label}" FontSize="12" Margin="0,10,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="输入音量" Style="{StaticResource SectionTitle}"/><TextBlock Text="调整手机声音的增益" Style="{StaticResource Label}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                <CheckBox x:Name="Muted" Grid.Column="1" Content="静音" VerticalAlignment="Center"/>
                <Slider x:Name="Gain" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="2" Value="1" StepFrequency="0.1" Margin="0,10,0,8" AutomationProperties.Name="输入音量增益"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                  <CheckBox x:Name="NoiseReduction" Content="RNNoise 背景降噪" AutomationProperties.Name="RNNoise 背景降噪"/>
                  <TextBlock x:Name="NoiseReductionHint" Text="关闭 · 保留原始声音，可在连接时切换。" Style="{StaticResource Label}" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid Grid.Row="3" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><ProgressBar x:Name="Meter" Minimum="0" Maximum="1" Height="4" VerticalAlignment="Center" AutomationProperties.Name="输入音量电平"/><TextBlock x:Name="AudioStats" Grid.Column="1" Text="48 kHz · 单声道 · 等待音频" Style="{StaticResource Label}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid>
              </Grid></Border>
            </StackPanel>
            <StackPanel x:Name="GuidePage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="通过蓝牙连接" Style="{StaticResource SectionTitle}"/><TextBlock Text="1. 在 Windows 蓝牙设置中与手机完成配对。&#10;2. 手机 LinkMic 选择蓝牙，首次连接输入配对码，点击开始。&#10;3. 电脑刷新设备、选择手机，点击开始接收。&#10;已配对设备再次连接时无需输入配对码。" LineHeight="26" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="通过 Wi-Fi 连接" Style="{StaticResource SectionTitle}"/><TextBlock Text="电脑与手机连接同一网络。电脑先选择 Wi-Fi 并开始接收；手机填写电脑地址，首次连接输入配对码，再点击开始。已配对设备再次连接时无需输码。首次连接可能需要允许 Windows 防火墙的专用网络访问。" LineHeight="26" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="在会议软件中使用" Style="{StaticResource SectionTitle}"/><TextBlock Text="1. 点击“驱动文件”，单独解压 VB-CABLE 原版 ZIP。&#10;2. 阅读 readme.txt，以管理员身份运行 VBCABLE_Setup_x64.exe，点击 Install Driver，然后重启电脑。&#10;3. LinkMic 选择 CABLE Input；会议或录音软件选择 CABLE Output。&#10;&#10;随包的官方签名驱动无需测试模式或关闭 Secure Boot。普通扬声器只用于监听。" LineHeight="26" Margin="0,12,0,0"/><Button Content="打开驱动文件夹" Click="OpenDriverFiles" Margin="0,16,0,0"/><TextBlock Text="VB-CABLE 来自 VB-Audio（vb-audio.com/Cable/），是 donationware，欢迎向原作者捐赠或购买许可证（shop.vb-audio.com）。原版包单独安装，保留原名及许可。" Style="{StaticResource Label}" FontSize="12" LineHeight="22" Margin="0,16,0,0"/></StackPanel></Border>
            </StackPanel>
            <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="连接状态和设备错误会显示在这里，日志不保存音频或配对码。" Style="{StaticResource Label}" Margin="0,0,0,12"/><TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="360" Height="440" FontFamily="Cascadia Mono, Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="运行日志"/></Grid>
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="应用主题" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择浅色、深色，或跟随 Windows" Style="{StaticResource Label}" FontSize="12" Margin="0,6,12,0"/></StackPanel><ComboBox x:Name="ThemeChoice" HorizontalAlignment="Stretch" Grid.Column="1" SelectionChanged="ThemeChanged" VerticalAlignment="Center" AutomationProperties.Name="界面主题"><ComboBoxItem Content="跟随 Windows" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox></Grid></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="已配对设备" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PairedDevicesInfo" Style="{StaticResource Label}" Margin="0,10,0,12"/><Button x:Name="ForgetDevicesButton" Content="忘记已配对设备" Click="ForgetDevices"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="关于 LinkMic" Style="{StaticResource SectionTitle}"/><TextBlock Text="Windows 0.3.5 · Android 0.2.4" Margin="0,12,0,6"/><TextBlock Text="通过蓝牙或 Wi-Fi，把手机的麦克风连接到电脑。" Style="{StaticResource Label}"/><TextBlock Text="VB-CABLE 由 VB-Audio 提供，是 donationware。欢迎支持原作者：vb-audio.com/Cable/ · shop.vb-audio.com。" Style="{StaticResource Label}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="准备就绪。请在手机端打开 LinkMic。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StopButton" Content="断开" IsEnabled="False" Click="StopClicked" Margin="0,0,8,0" MinWidth="76" MinHeight="34"/><Button x:Name="StartButton" Content="开始接收" Style="{StaticResource AccentButtonStyle}" Click="StartClicked" MinWidth="112" MinHeight="34"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </NavigationView.Content>
  </NavigationView>
</Window>
