<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/colorSurface">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp" app:title="@string/app_name" app:subtitle="@string/app_subtitle" app:titleTextAppearance="@style/LinkMic.ToolbarTitle" app:subtitleTextAppearance="@style/LinkMic.ToolbarSubtitle" app:subtitleTextColor="?attr/colorOnSurfaceVariant" app:menu="@menu/main_menu"/>
  <androidx.core.widget.NestedScrollView android:id="@+id/connection_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="4dp" android:paddingBottom="16dp">
      <com.google.android.material.card.MaterialCardView android:id="@+id/session_card" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:cardCornerRadius="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="16dp">
          <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/session_duration" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnPrimaryContainer"/>
          <com.google.android.material.textview.MaterialTextView android:id="@+id/connection_duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/zero_duration" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:textSize="34sp" android:letterSpacing="0.01" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="2sp" android:textColor="?attr/colorOnPrimaryContainer"/>
          <com.google.android.material.textview.MaterialTextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ready" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnPrimaryContainer" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView style="@style/LinkMic.SurfaceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
          <com.google.android.material.textview.MaterialTextView style="@style/LinkMic.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection"/>
          <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/connection_modes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:baselineAligned="false" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/mode_bluetooth">
            <com.google.android.material.button.MaterialButton android:id="@+id/mode_bluetooth" style="@style/LinkMic.ModeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/bluetooth" app:icon="@drawable/ic_bluetooth"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/mode_wifi" style="@style/LinkMic.ModeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/wifi" app:icon="@drawable/ic_wifi"/>
          </com.google.android.material.button.MaterialButtonToggleGroup>
          <com.google.android.material.textview.MaterialTextView android:id="@+id/connection_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/bluetooth_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:lineSpacingExtra="3dp"/>
          <com.google.android.material.textfield.TextInputLayout android:id="@+id/host_layout" style="@style/LinkMic.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/computer_address" android:visibility="gone" app:helperText="@string/computer_address_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/computer_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" android:textSize="16sp"/>
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textview.MaterialTextView android:id="@+id/trusted_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/not_paired" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/pair_new_computer" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:text="@string/pair_new_computer" android:visibility="gone"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/pairing_card" style="@style/LinkMic.SurfaceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
          <com.google.android.material.textview.MaterialTextView style="@style/LinkMic.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/first_pairing"/>
          <com.google.android.material.textfield.TextInputLayout android:id="@+id/code_layout" style="@style/LinkMic.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/pairing_code" app:helperText="@string/pairing_help">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/pairing_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="6" android:maxLines="1" android:textSize="20sp" android:fontFamily="monospace" android:letterSpacing="0.12" android:imeOptions="actionDone" android:importantForAutofill="no" android:saveEnabled="false"/>
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView style="@style/LinkMic.SurfaceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.textview.MaterialTextView style="@style/LinkMic.SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/audio_level"/>
            <com.google.android.material.textview.MaterialTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/audio_format" android:textAppearance="?attr/textAppearanceLabelSmall" android:textColor="?attr/colorOnSurfaceVariant"/>
          </LinearLayout>
          <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/audio_meter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="false" android:max="100" app:trackThickness="5dp" app:trackCornerRadius="3dp"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <com.google.android.material.button.MaterialButton android:id="@+id/start_connection" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="56dp" android:text="@string/start" android:fontFamily="sans-serif-medium" app:cornerRadius="18dp" app:icon="@drawable/ic_play" app:iconGravity="textStart" app:iconSize="20dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/stop_connection" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:minWidth="96dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:minHeight="56dp" android:enabled="false" android:text="@string/stop" app:cornerRadius="18dp"/>
    </LinearLayout>
    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/recording_hint" android:gravity="center" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant"/>
  </LinearLayout>
</LinearLayout>
