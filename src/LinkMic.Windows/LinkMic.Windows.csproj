<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AssemblyName>LinkMic</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/LinkMic.ico</ApplicationIcon>
    <Version>0.3.5</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="assets\LinkMic.ico;assets\LinkMic.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="$(PkgMicrosoft_WindowsAppSDK)/license.txt" Link="licenses/WindowsAppSDK-LICENSE.txt" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="$(PkgMicrosoft_WindowsAppSDK)/NOTICE.txt" Link="licenses/WindowsAppSDK-NOTICE.txt" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <ItemGroup><Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><Content Include="../../native/win-x64/rnnoise.dll" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../LinkMic.Core/LinkMic.Core.csproj"/>
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5"/>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" GeneratePathProperty="true"/>
  </ItemGroup>
</Project>
