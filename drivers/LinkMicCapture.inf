; LinkMic original capture package. The WaveRT miniport framework is MS-PL licensed.
; Development build: catalog and .sys must be properly signed before installation.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/14/2026,0.2.0.0
CatalogFile=LinkMicCapture.cat
PnpLockDown=1

[Manufacturer]
%Provider%=LinkMic,NTamd64.10.0...22621

[LinkMic.NTamd64.10.0...22621]
%DeviceDesc%=Capture,ROOT\LinkMicCapture

[DestinationDirs]
Capture.CopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
LinkMicCapture.sys=1

[Capture.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Capture.CopyFiles
AddReg=Capture.AddReg

[Capture.CopyFiles]
LinkMicCapture.sys

[Capture.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,"LinkMicCapture.sys"
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,"wdmaud.drv"
HKR,Drivers\mixer\wdmaud.drv,Driver,,"wdmaud.drv"
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%
HKR,,DoNotCreateDataFiles,0x00010001,1
HKR,,DisableToneGenerator,0x00010001,1

[Capture.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%WaveName%,WaveInterface
AddInterface=%KSCATEGORY_CAPTURE%,%WaveName%,WaveInterface
AddInterface=%KSCATEGORY_REALTIME%,%WaveName%,WaveInterface
AddInterface=%KSCATEGORY_AUDIO%,%TopologyName%,TopologyInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,%TopologyName%,TopologyInterface

[WaveInterface]
AddReg=WaveInterface.AddReg

[WaveInterface.AddReg]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%EndpointName%

[TopologyInterface]
AddReg=TopologyInterface.AddReg

[TopologyInterface.AddReg]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%EndpointName%
HKR,EP\0,%PKEY_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_EventDriven%,0x00010001,1

[Capture.NT.Services]
AddService=LinkMicCapture,0x00000002,Capture.Service

[Capture.Service]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\LinkMicCapture.sys

[Capture.NT.HW]
AddReg=Capture.Hardware

[Capture.Hardware]
HKR,,DeviceType,0x00010001,0x0000001d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Capture.NT.Wdf]
KmdfService=LinkMicCapture,Capture.Kmdf

[Capture.Kmdf]
KmdfLibraryVersion=1.33

[Strings]
Provider="LinkMic Project"
DeviceDesc="LinkMic Virtual Microphone"
EndpointName="LinkMic Virtual Microphone"
DiskName="LinkMic Virtual Microphone Driver"
WaveName="WaveMicArray1"
TopologyName="TopologyMicArray1"
ProxyCLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

